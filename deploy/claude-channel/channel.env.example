# Claude channel configuration
# Copy this file to channel.env to apply custom settings.
# cp channel.env.example channel.env

# Discord plugin channel (default: plugin:discord@claude-plugins-official)
# CLAUDE_CHANNELS="plugin:discord@claude-plugins-official"

# Claude CLI flags (default: none)
# CLAUDE_FLAGS="--debug"
# CLAUDE_FLAGS="--debug --dangerously-skip-permissions"

# Additional claude CLI arguments appended after CLAUDE_FLAGS
# CLAUDE_EXTRA_ARGS="--verbose"
